---
const today = new Date()
const qqGroupNumber = '544739044'
---

<footer class="px-4 py-8 text-center">
  <div>&copy; {today.getFullYear()} AIProxy Shop. 版权所有</div>
  <div class="mt-3 flex flex-wrap items-center justify-center gap-3 text-sm">
    <span>联系邮箱：hi@aiproxy.shop</span>
    <span class="hidden h-3.5 w-px bg-current md:block"></span>
    <span class="inline-flex items-center gap-1.5">
      <img class="h-4 w-4 shrink-0" src="/imgs/qq.svg" alt="QQ" />
      <span>QQ群：{qqGroupNumber}</span>
    </span>
    <button
      class="max-md:max-w-48 max-md:w-full cursor-pointer rounded-full border border-primary bg-primary px-[0.95rem] py-[0.55rem] leading-none text-white transition hover:-translate-y-px hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      type="button"
      data-qq-group-number={qqGroupNumber}
      data-default-label="加入 QQ 群"
    >
      加入 QQ 群
    </button>
  </div>
  <div class="mt-4 flex items-center justify-center text-sm">
    <a class="px-4" href="/terms">用户服务协议</a>
    <div class="h-4 w-px bg-current"></div>
    <a class="px-4" href="/privacy">隐私政策</a>
  </div>
</footer>
<script>
  import copy from 'copy-to-clipboard'

  document.querySelectorAll('[data-qq-group-number]').forEach((element) => {
    if (!(element instanceof HTMLButtonElement)) {
      return
    }

    if (element.dataset.bound === 'true') {
      return
    }

    element.dataset.bound = 'true'

    const defaultLabel = element.dataset.defaultLabel ?? '加入 QQ 群'
    let resetTimer = 0

    const setLabel = (label: string) => {
      element.textContent = label
    }

    element.addEventListener('click', () => {
      const groupNumber = element.dataset.qqGroupNumber ?? ''

      if (copy(groupNumber)) {
        setLabel('已复制群号')
      } else {
        setLabel(`QQ群：${groupNumber}`)
      }

      window.clearTimeout(resetTimer)
      resetTimer = window.setTimeout(() => {
        setLabel(defaultLabel)
      }, 1800)
    })
  })
</script>
