---
import { MonitorIcon, MoonIcon, SunIcon } from '@lucide/astro'

declare global {
  interface Window {
    siteTheme?: {
      getPreference?: () => string
      setPreference?: (preference: string) => void
    }
  }
}
---

<div class="theme-toggle" data-theme-toggle>
  <span class="sr-only">切换主题</span>
  <button type="button" data-theme-option="light" aria-label="切换到亮色主题">
    <SunIcon class="theme-toggle__icon" aria-hidden="true" />
  </button>
  <button type="button" data-theme-option="dark" aria-label="切换到暗色主题">
    <MoonIcon class="theme-toggle__icon" aria-hidden="true" />
  </button>
  <button type="button" data-theme-option="system" aria-label="跟随系统主题">
    <MonitorIcon class="theme-toggle__icon" aria-hidden="true" />
  </button>
</div>

<script>
  /** @typedef {'light' | 'dark' | 'system'} ScriptThemePreference */

  const syncThemeToggles = (
    /** @type {ScriptThemePreference} */
    preference = window.siteTheme?.getPreference?.() ?? 'system'
  ) => {
    document
      .querySelectorAll<HTMLElement>('[data-theme-toggle]')
      .forEach((toggle) => {
        toggle
          .querySelectorAll<HTMLButtonElement>('[data-theme-option]')
          .forEach((button) => {
            const isActive = button.dataset.themeOption === preference
            button.dataset.active = String(isActive)
            button.setAttribute('aria-pressed', String(isActive))
          })
      })
  }

  document
    .querySelectorAll<HTMLElement>('[data-theme-toggle]')
    .forEach((toggle) => {
      if (toggle.dataset.bound === 'true') {
        return
      }

      toggle.dataset.bound = 'true'

      toggle
        .querySelectorAll<HTMLButtonElement>('[data-theme-option]')
        .forEach((button) => {
          button.addEventListener('click', () => {
            const preference = /** @type {ScriptThemePreference} */ (
              button.dataset.themeOption ?? 'system'
            )
            window.siteTheme?.setPreference?.(preference)
          })
        })
    })

  syncThemeToggles()
  window.addEventListener('themechange', (event) => {
    const customEvent = event as CustomEvent<{
      preference?: 'light' | 'dark' | 'system'
    }>

    syncThemeToggles(customEvent.detail?.preference)
  })
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.25rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background-color: var(--surface-color);
  }

  .theme-toggle button {
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: inherit;
    cursor: pointer;
    line-height: 1;
    padding: 0.5rem;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .theme-toggle__icon {
    width: 1rem;
    height: 1rem;
  }

  .theme-toggle button[data-active='true'] {
    background-color: var(--primary-color);
    color: var(--text-color);
  }

  .theme-toggle button:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--primary-color) 70%, white);
    outline-offset: 2px;
  }

  .theme-toggle button:hover {
    transform: translateY(-1px);
  }

  @media screen and (max-width: 48rem) {
    .theme-toggle button {
      padding: 0.5rem;
    }
  }
</style>
