---
import { MonitorIcon, MoonIcon, SunIcon } from '@lucide/astro'

declare global {
  interface Window {
    siteTheme?: {
      getPreference?: () => string
      setPreference?: (preference: string) => void
    }
  }
}
---

<div class="theme-toggle" data-theme-toggle>
  <div
    class="inline-flex items-center gap-0.5 rounded-full border border-border bg-(--surface-color) p-1"
    data-theme-toggle
  >
    <span class="sr-only">切换主题</span>
    <button
      type="button"
      class="inline-flex cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-2 leading-none text-inherit transition-[background-color,color,transform] duration-150 ease-out hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color-mix(in_oklab,var(--primary-color)_70%,white)] data-[active=true]:bg-primary data-[active=true]:text-(--text-color)"
      data-theme-option="light"
      aria-label="切换到亮色主题"
    >
      <SunIcon class="h-4 w-4" aria-hidden="true" />
    </button>
    <button
      type="button"
      class="inline-flex cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-2 leading-none text-inherit transition-[background-color,color,transform] duration-150 ease-out hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color-mix(in_oklab,var(--primary-color)_70%,white)] data-[active=true]:bg-primary data-[active=true]:text-(--text-color)"
      data-theme-option="dark"
      aria-label="切换到暗色主题"
    >
      <MoonIcon class="h-4 w-4" aria-hidden="true" />
    </button>
    <button
      type="button"
      class="inline-flex cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-2 leading-none text-inherit transition-[background-color,color,transform] duration-150 ease-out hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color-mix(in_oklab,var(--primary-color)_70%,white)] data-[active=true]:bg-primary data-[active=true]:text-(--text-color)"
      data-theme-option="system"
      aria-label="跟随系统主题"
    >
      <MonitorIcon class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>

  <script>
    /** @typedef {'light' | 'dark' | 'system'} ScriptThemePreference */

    const syncThemeToggles = (
      /** @type {ScriptThemePreference} */
      preference = window.siteTheme?.getPreference?.() ?? 'system'
    ) => {
      document
        .querySelectorAll<HTMLElement>('[data-theme-toggle]')
        .forEach((toggle) => {
          toggle
            .querySelectorAll<HTMLButtonElement>('[data-theme-option]')
            .forEach((button) => {
              const isActive = button.dataset.themeOption === preference
              button.dataset.active = String(isActive)
              button.setAttribute('aria-pressed', String(isActive))
            })
        })
    }

    document
      .querySelectorAll<HTMLElement>('[data-theme-toggle]')
      .forEach((toggle) => {
        if (toggle.dataset.bound === 'true') {
          return
        }

        toggle.dataset.bound = 'true'

        toggle
          .querySelectorAll<HTMLButtonElement>('[data-theme-option]')
          .forEach((button) => {
            button.addEventListener('click', () => {
              const preference = /** @type {ScriptThemePreference} */ (
                button.dataset.themeOption ?? 'system'
              )
              window.siteTheme?.setPreference?.(preference)
            })
          })
      })

    syncThemeToggles()
    window.addEventListener('themechange', (event) => {
      const customEvent = event as CustomEvent<{
        preference?: 'light' | 'dark' | 'system'
      }>

      syncThemeToggles(customEvent.detail?.preference)
    })
  </script>
</div>
