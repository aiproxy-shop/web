---
interface Props {
  ariaLabel: string
  icon: any
  option: 'light' | 'dark' | 'system'
}

const { ariaLabel, icon: Icon, option } = Astro.props
---

<button
  type="button"
  class="inline-flex cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-2 leading-none text-inherit transition-[background-color,color,transform] duration-150 ease-out hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color-mix(in_oklab,var(--color-primary)_70%,white)] data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"
  data-theme-option={option}
  aria-label={ariaLabel}
>
  <Icon class="h-4 w-4" aria-hidden="true" />
</button>
