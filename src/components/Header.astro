---
import Logo from './Logo.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header
  class="fixed top-0 left-0 z-10 w-full flex items-center h-16 bg-background border-b border-border px-4"
>
  <nav class="flex items-center shrink-0">
    <h2>
      <a href="/">
        <Logo class="h-10 w-auto" />
      </a>
    </h2>
  </nav>

  <div class="flex-1"></div>

  <div class="flex items-center mx-6">
    <a
      class="text-sm select-none cursor-pointer whitespace-nowrap"
      href="/docs/get-started">文档</a
    >
  </div>

  <div class="flex items-center space-x-3 md:space-x-4">
    <ThemeToggle />
    <a
      class="hidden whitespace-nowrap rounded border border-primary px-4 py-2 text-primary md:inline-flex"
      href="https://app.aiproxy.shop/">登录</a
    >
    <a
      class="inline-flex whitespace-nowrap rounded border border-primary bg-primary px-4 py-2 text-primary-foreground"
      href="https://app.aiproxy.shop/auth/login">马上注册</a
    >
  </div>
</header>
