---
import MainLayout from '../layouts/MainLayout.astro'
import FeatureCard from '../components/FeatureCard.astro'
import { GlobeIcon, ZapIcon, ShieldCheckIcon } from '@lucide/astro'

const iconIdsNeedingSurface = ['Kimi']

const modelSuppliers = [
  { name: '百炼', iconId: 'Bailian' },
  { name: 'Vercel AI Gateway', iconId: 'Vercel' },
  { name: 'Kimi', iconId: 'Kimi' },
  { name: 'DeepInfra', iconId: 'DeepInfra' },
  { name: 'DeepSeek', iconId: 'DeepSeek' },
  { name: 'Minimax', iconId: 'Minimax' },
  { name: 'Open Code', iconId: 'OpenCode' },
  { name: 'OpenRouter', iconId: 'OpenRouter' },
  { name: 'Baseten', iconId: 'Baseten' },
  { name: 'Novita', iconId: 'Novita' },
  { name: 'Fireworks', iconId: 'Fireworks' },
  { name: 'Zeabur', iconId: 'Zeabur' },
].map((supplier) => ({
  ...supplier,
  iconSrc: `/imgs/providers/${supplier.iconId}.svg`,
  needsSurface: iconIdsNeedingSurface.includes(supplier.iconId),
}))
---

<MainLayout>
  <div class="flex border-b border-border px-4 py-16">
    <div class="mx-auto flex min-w-0 max-w-5xl flex-1 flex-col">
      <h2 class="mb-8 text-4xl font-bold md:text-5xl">
        让好用的 AI 模型触手可及。
      </h2>
      <p class="mb-6 max-w-160 leading-6 md:text-base md:leading-7">
        无需复杂网络环境，一个账户即可畅调全球顶尖模型。AIProxy Shop
        提供安全透明的额度管理与极速响应的转发通道，助您快速开启智能创作之旅。
      </p>

      <div class="flex items-center gap-4">
        <a
          class="inline-block rounded-(--border-radius) border border-primary bg-primary px-8 py-4 text-background"
          href="https://app.aiproxy.shop">马上开始</a
        >

        <a
          href="/models"
          class="inline-flex rounded border border-border bg-background px-6 py-4 hover:bg-muted"
        >
          模型列表
          <div class="ml-2 flex items-center -space-x-2">
            {
              ['deepseek', 'zai', 'minimax'].map((ownedBy) => (
                <div class="h-6 w-6 rounded-full border border-border bg-background p-0.5">
                  <img
                    class="h-full w-full"
                    src={`/imgs/${ownedBy}.svg`}
                    alt={ownedBy}
                  />
                </div>
              ))
            }
          </div>
        </a>
      </div>
    </div>
  </div>

  <section class="border-b border-border px-4 py-12">
    <div class="mx-auto flex max-w-5xl flex-col gap-6">
      <div class="max-w-2xl text-center mx-auto">
        <h3 class="text-3xl font-bold">模型供应商</h3>
        <p class="mt-3 text-base leading-7 text-foreground/75">
          覆盖国内外主流模型平台与聚合通道，支持你按场景灵活切换不同供应商能力。
        </p>
      </div>

      <div class="overflow-hidden border border-border bg-border">
        <div
          class="grid grid-cols-2 gap-px bg-border sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6"
        >
          {
            modelSuppliers.map((supplier) => (
              <div class="flex min-h-28 flex-col items-center justify-center bg-background px-4 py-6 text-center">
                <div
                  class:list={[
                    'flex min-h-12 items-center justify-center px-3',
                    supplier.needsSurface &&
                      'h-14 w-14 rounded-md bg-slate-900 px-2 dark:bg-slate-100',
                  ]}
                >
                  <img
                    class="h-10 w-auto max-w-28 object-contain"
                    src={supplier.iconSrc}
                    alt={supplier.name}
                    loading="lazy"
                  />
                </div>
                <div class="mt-3 text-sm font-medium leading-5 text-foreground">
                  {supplier.name}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <div class="border-b border-border">
    <div class="mx-auto flex max-w-5xl flex-col items-stretch md:flex-row">
      <FeatureCard
        title="聚合接口，一键切换"
        description="全场景 API 支持。一个账户畅调 OpenAI, Gemini, Grok 等全球主流模型，告别多平台维护烦恼。"
        class="md:first:border-l md:last:border-r"
      >
        <GlobeIcon slot="icon" class="h-5 w-5" />
      </FeatureCard>

      <FeatureCard
        title="极速中转，国内直连"
        description="100% 兼容原生接口。 毫秒级延迟响应，国内环境直连，只需修改 Base URL 即可秒速无缝接入。"
        class="border-t md:border-t-0 md:border-l-0"
      >
        <ZapIcon slot="icon" class="h-5 w-5" />
      </FeatureCard>

      <FeatureCard
        title="额度隔离，安全透明"
        description="支持多 Key 独立管理。配合可视化账单看板，每一分消耗都清晰透明。"
        class="border-t md:border-t-0 md:border-l-0 md:last:border-r"
      >
        <ShieldCheckIcon slot="icon" class="h-5 w-5" />
      </FeatureCard>
    </div>
  </div>
</MainLayout>
