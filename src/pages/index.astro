---
import CoreFeatures from '../components/CoreFeatures.astro'
import MainLayout from '../layouts/MainLayout.astro'
import ProviderGrid from '../components/ProviderGrid.astro'
---

<MainLayout>
  <div class="flex px-4 py-32">
    <div
      class="mx-auto flex min-w-0 max-w-5xl flex-1 flex-col items-center justify-center"
    >
      <h2 class="mb-8 text-4xl font-bold md:text-5xl">
        让好用的 AI 模型触手可及
      </h2>
      <p class="mb-6 max-w-160 leading-6 md:text-base md:leading-7">
        无需复杂网络环境，一个账户即可畅调全球顶尖模型。AIProxy Shop
        提供安全透明的额度管理与极速响应的转发通道，助您快速开启智能创作之旅。
      </p>

      <div class="flex items-center gap-4">
        <a
          class="inline-block rounded-(--border-radius) border border-primary bg-primary px-8 py-4 text-primary-foreground"
          href="https://app.aiproxy.shop">现在开始</a
        >

        <a
          href="/models"
          class="inline-flex rounded border border-border bg-background px-6 py-4 hover:bg-muted"
        >
          模型列表
          <div class="ml-2 flex items-center -space-x-2">
            {
              ['deepseek', 'zai', 'minimax'].map((ownedBy) => (
                <div class="h-6 w-6 rounded-full border border-border bg-background p-0.5">
                  <img
                    class="h-full w-full"
                    src={`/imgs/${ownedBy}.svg`}
                    alt={ownedBy}
                  />
                </div>
              ))
            }
          </div>
        </a>
      </div>
    </div>
  </div>

  <ProviderGrid />

  <CoreFeatures />
</MainLayout>
